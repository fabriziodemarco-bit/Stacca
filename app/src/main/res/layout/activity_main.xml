<?xml version="1.0" encoding="utf-8"?>
<!--
    Home di Stacca in stile "editoriale", tutta in una schermata:
    1. header (nome + badge Premium)
    2. messaggio principale (etichetta, titolo, riga secondaria)
    3. una sola scheda informativa (cambia con il momento)
    4. spiegazione breve di Insultami
    5. azioni (un solo pulsante dominante + uno secondario)
    6. Impostazioni
    Lo ScrollView serve solo con caratteri molto ingranditi: in condizioni normali non scorre.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <!-- 1. Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="44dp">

            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textSize="28sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="-0.02"
                android:textColor="@color/home_accent" />

            <TextView
                android:id="@+id/tvPremiumBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="32dp"
                android:gravity="center"
                android:background="@drawable/bg_badge"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/premium_badge"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:textColor="@color/home_text_secondary" />
        </LinearLayout>

        <!-- Card Protezione Allarmi (visibile solo se manca almeno un permesso) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPermissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardBackgroundColor="@color/home_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#FFAB00"
            app:strokeWidth="1dp"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/perm_card_title"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/home_text"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvPermNotification"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:gravity="center_vertical"
                    android:textSize="13sp"
                    android:textColor="@color/home_text_secondary"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tvPermExactAlarm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:gravity="center_vertical"
                    android:textSize="13sp"
                    android:textColor="@color/home_text_secondary"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tvPermBattery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:gravity="center_vertical"
                    android:textSize="13sp"
                    android:textColor="@color/home_text_secondary"
                    android:focusable="true" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Space
            android:id="@+id/spaceTop"
            android:layout_width="match_parent"
            android:layout_height="24dp" />

        <!-- 2. Messaggio principale -->
        <TextView
            android:id="@+id/tvHeroLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.14"
            android:textColor="@color/home_text_secondary" />

        <TextView
            android:id="@+id/tvHeroTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="30sp"
            android:fontFamily="sans-serif-black"
            android:lineSpacingMultiplier="1.08"
            android:letterSpacing="-0.01"
            android:textColor="@color/home_text" />

        <TextView
            android:id="@+id/tvHeroSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="14sp"
            android:textColor="@color/home_text_secondary" />

        <!-- 3. Una sola scheda informativa -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/home_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvCardLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.14"
                    android:textColor="@color/home_text_secondary" />

                <TextView
                    android:id="@+id/tvCardValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="46sp"
                    android:textStyle="bold"
                    android:fontFeatureSettings="tnum"
                    android:letterSpacing="-0.02"
                    android:includeFontPadding="false"
                    android:textColor="@color/home_text" />

                <!-- Sei segmenti: uno per ogni promemoria inviato -->
                <LinearLayout
                    android:id="@+id/segments"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <View android:id="@+id/seg1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="6dp" android:background="@drawable/bg_segment" />
                    <View android:id="@+id/seg2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="6dp" android:background="@drawable/bg_segment" />
                    <View android:id="@+id/seg3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="6dp" android:background="@drawable/bg_segment" />
                    <View android:id="@+id/seg4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="6dp" android:background="@drawable/bg_segment" />
                    <View android:id="@+id/seg5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="6dp" android:background="@drawable/bg_segment" />
                    <View android:id="@+id/seg6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_segment" />
                </LinearLayout>

                <!-- Riga finale: testo a sinistra, valore o comando a destra -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvCardFootLeft"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="13sp"
                        android:textColor="@color/home_text_secondary" />

                    <TextView
                        android:id="@+id/tvCardFootRight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="44dp"
                        android:minWidth="44dp"
                        android:gravity="center_vertical|end"
                        android:textSize="13sp"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/home_text_secondary" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 4. Spiegazione breve di Insultami -->
        <TextView
            android:id="@+id/tvExplain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.15"
            android:textColor="@color/home_text_secondary" />

        <Space
            android:id="@+id/spaceBottom"
            android:layout_width="match_parent"
            android:layout_height="20dp" />

        <!-- 5. Azioni: un solo pulsante dominante -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrimary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:letterSpacing="0"
            android:textColor="@color/home_on_accent"
            app:backgroundTint="@color/home_accent"
            app:cornerRadius="14dp"
            app:elevation="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSecondary"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:letterSpacing="0"
            android:textColor="@color/home_text"
            app:strokeColor="@color/home_border"
            app:strokeWidth="1dp"
            app:cornerRadius="14dp" />

        <!-- 6. Riga finale: "Ancora X minuti" (solo in straordinario) e Impostazioni -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/tvSnooze"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="44dp"
                android:gravity="center_vertical|start"
                android:textSize="14sp"
                android:textColor="@color/home_text"
                android:background="?attr/selectableItemBackground"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:minWidth="44dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center"
                android:text="@string/home_settings"
                android:textSize="13sp"
                android:textColor="@color/home_text_secondary"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <!-- Lo spazio libero resta in fondo: i comandi stanno in alto -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>
</ScrollView>
