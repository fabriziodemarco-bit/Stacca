<?xml version="1.0" encoding="utf-8"?>
<!--
    Paywall: l'unica schermata di vendita, nello stile "editoriale" della home.
    Etichetta, titolo, una scheda con cosa si sblocca, un pulsante dominante.
    Il prezzo sul pulsante arriva sempre da Google Play.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="24dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/paywall_label"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.14"
            android:textColor="@color/home_accent" />

        <TextView
            android:id="@+id/tvPaywallTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/paywall_title_v2"
            android:textSize="30sp"
            android:fontFamily="sans-serif-black"
            android:lineSpacingMultiplier="1.08"
            android:letterSpacing="-0.01"
            android:textColor="@color/home_text" />

        <TextView
            android:id="@+id/tvPaywallSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/paywall_sub_v2"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.15"
            android:textColor="@color/home_text_secondary" />

        <!-- Cosa si sblocca -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Stacca.Settings.Card"
            android:layout_marginTop="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout style="@style/Stacca.Settings.Row">
                    <LinearLayout style="@style/Stacca.Settings.RowTexts">
                        <TextView
                            style="@style/Stacca.Settings.RowTitle"
                            android:text="@string/paywall_f1_title" />
                        <TextView
                            style="@style/Stacca.Settings.RowDesc"
                            android:text="@string/paywall_f1_desc" />
                    </LinearLayout>
                </LinearLayout>

                <View style="@style/Stacca.Settings.Divider" />

                <LinearLayout style="@style/Stacca.Settings.Row">
                    <LinearLayout style="@style/Stacca.Settings.RowTexts">
                        <TextView
                            style="@style/Stacca.Settings.RowTitle"
                            android:text="@string/paywall_f2_title" />
                        <TextView
                            style="@style/Stacca.Settings.RowDesc"
                            android:text="@string/paywall_f2_desc" />
                    </LinearLayout>
                </LinearLayout>

                <View style="@style/Stacca.Settings.Divider" />

                <LinearLayout style="@style/Stacca.Settings.Row">
                    <LinearLayout style="@style/Stacca.Settings.RowTexts">
                        <TextView
                            style="@style/Stacca.Settings.RowTitle"
                            android:text="@string/paywall_f3_title" />
                        <TextView
                            style="@style/Stacca.Settings.RowDesc"
                            android:text="@string/paywall_f3_desc" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/paywall_once"
            android:textSize="14sp"
            android:textColor="@color/home_text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/paywall_support"
            android:textSize="13sp"
            android:textColor="@color/home_text_secondary" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="20dp" />

        <!-- Acquisto: il testo con il prezzo lo imposta il codice -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUnlock"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/paywall_unlock_v2"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:letterSpacing="0"
            android:textColor="@color/home_on_accent"
            app:backgroundTint="@color/home_accent"
            app:cornerRadius="14dp"
            app:elevation="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNoThanks"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/paywall_no_thanks"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:letterSpacing="0"
            android:textColor="@color/home_text"
            app:strokeColor="@color/home_border"
            app:strokeWidth="1dp"
            app:cornerRadius="14dp" />

        <TextView
            android:id="@+id/tvPaywallRestore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:minHeight="44dp"
            android:minWidth="44dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:gravity="center"
            android:text="@string/premium_restore"
            android:textSize="13sp"
            android:textColor="@color/home_text_secondary"
            android:background="?attr/selectableItemBackgroundBorderless" />

    </LinearLayout>
</ScrollView>
