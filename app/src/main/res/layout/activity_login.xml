<?xml version="1.0" encoding="utf-8"?>
<!-- Pagina di accesso (facoltativo), nello stile "editoriale" della home -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nestedScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="@dimen/page_padding_top"
        android:paddingBottom="24dp">

        <!-- Messaggio principale -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_label"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.14"
            android:textColor="@color/home_accent" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/login_title"
            android:textSize="@dimen/page_title_size"
            android:fontFamily="sans-serif-black"
            android:lineSpacingMultiplier="1.08"
            android:letterSpacing="-0.01"
            android:textColor="@color/home_text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/login_sub"
            android:textSize="14sp"
            android:textColor="@color/home_text_secondary" />

        <!-- Spazio flessibile: il blocco di accesso scende verso il basso -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/page_card_margin_top" />

        <!-- Google -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoogleSignIn"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/login_google"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:letterSpacing="0"
            android:textColor="@color/home_text"
            app:icon="@drawable/ic_google"
            app:iconGravity="textStart"
            app:iconTint="@null"
            app:iconSize="20dp"
            app:cornerRadius="14dp"
            app:strokeColor="@color/home_border"
            app:strokeWidth="1dp" />

        <!-- "oppure" -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/home_border" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/login_divider"
                android:textSize="13sp"
                android:textColor="@color/home_text_secondary" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/home_border" />
        </LinearLayout>

        <!-- Email e password -->
        <com.google.android.material.card.MaterialCardView style="@style/Stacca.Settings.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabLayout"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginBottom="12dp"
                    android:background="@android:color/transparent"
                    app:tabTextColor="@color/home_text_secondary"
                    app:tabSelectedTextColor="@color/home_text"
                    app:tabIndicatorColor="@color/home_accent"
                    app:tabRippleColor="@android:color/transparent"
                    app:tabMode="fixed"
                    app:tabGravity="fill">

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/login_tab_login" />

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/login_tab_register" />
                </com.google.android.material.tabs.TabLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilEmail"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:hint="@string/login_email_hint"
                    android:textColorHint="@color/home_text_secondary"
                    app:boxStrokeColor="@color/home_accent"
                    app:hintTextColor="@color/home_accent"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:textColor="@color/home_text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPassword"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/login_password_hint"
                    android:textColorHint="@color/home_text_secondary"
                    app:boxStrokeColor="@color/home_accent"
                    app:hintTextColor="@color/home_accent"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/home_text_secondary"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textColor="@color/home_text" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvForgotPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:minHeight="44dp"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="4dp"
                    android:text="@string/login_forgot_password"
                    android:textSize="13sp"
                    android:textColor="@color/home_accent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/login_btn_login"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:letterSpacing="0"
                    android:textColor="@color/home_on_accent"
                    app:backgroundTint="@color/home_accent"
                    app:cornerRadius="14dp"
                    app:elevation="0dp" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progressLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="12dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="@color/home_accent" />

                <TextView
                    android:id="@+id/tvError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textSize="13sp"
                    android:textColor="@color/alert_aggressive"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
