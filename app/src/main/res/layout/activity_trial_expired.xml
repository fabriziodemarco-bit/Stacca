<?xml version="1.0" encoding="utf-8"?>
<!-- Fine della prova gratuita (mostrata una sola volta), nello stile "editoriale" della home -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="@dimen/page_padding_top"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/trial_v2_label"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.14"
            android:textColor="@color/home_accent" />

        <TextView
            android:id="@+id/tvTrialTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/trial_v2_title"
            android:textSize="@dimen/page_title_size"
            android:fontFamily="sans-serif-black"
            android:lineSpacingMultiplier="1.08"
            android:letterSpacing="-0.01"
            android:textColor="@color/home_text" />

        <TextView
            android:id="@+id/tvTrialSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/trial_v2_sub"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.15"
            android:textColor="@color/home_text_secondary" />

        <!-- Gratis per sempre: una riga sola -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/trial_v2_free_line"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/home_text" />

        <!-- Con Premium -->
        <TextView
            style="@style/Stacca.Settings.SectionLabel"
            android:layout_marginTop="16dp"
            android:text="@string/trial_v2_premium_label" />

        <com.google.android.material.card.MaterialCardView style="@style/Stacca.Settings.Card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout style="@style/Stacca.Settings.Row">
                    <LinearLayout style="@style/Stacca.Settings.RowTexts">
                        <TextView style="@style/Stacca.Settings.RowTitle" android:text="@string/paywall_f1_title" />
                        <TextView style="@style/Stacca.Settings.RowDesc" android:text="@string/paywall_f1_desc" />
                    </LinearLayout>
                </LinearLayout>

                <View style="@style/Stacca.Settings.Divider" />

                <LinearLayout style="@style/Stacca.Settings.Row">
                    <LinearLayout style="@style/Stacca.Settings.RowTexts">
                        <TextView style="@style/Stacca.Settings.RowTitle" android:text="@string/paywall_f2_title" />
                        <TextView style="@style/Stacca.Settings.RowDesc" android:text="@string/paywall_f2_desc" />
                    </LinearLayout>
                </LinearLayout>

                <View style="@style/Stacca.Settings.Divider" />

                <LinearLayout style="@style/Stacca.Settings.Row">
                    <LinearLayout style="@style/Stacca.Settings.RowTexts">
                        <TextView style="@style/Stacca.Settings.RowTitle" android:text="@string/paywall_f3_title" />
                        <TextView style="@style/Stacca.Settings.RowDesc" android:text="@string/paywall_f3_desc" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="20dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTrialRegister"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/trial_v2_btn_premium"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:letterSpacing="0"
            android:textColor="@color/home_on_accent"
            app:backgroundTint="@color/home_accent"
            app:cornerRadius="14dp"
            app:elevation="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTrialContinueFree"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/trial_v2_btn_free"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:letterSpacing="0"
            android:textColor="@color/home_text"
            app:strokeColor="@color/home_border"
            app:strokeWidth="1dp"
            app:cornerRadius="14dp" />

    </LinearLayout>
</ScrollView>
