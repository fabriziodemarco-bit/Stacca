<?xml version="1.0" encoding="utf-8"?>
<!-- Insultami: un minuto di insulti a tutto schermo, stessa tipografia della home -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/insultRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/alert_aggressive">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="24dp"
        android:paddingBottom="16dp">

        <!-- Fase corrente -->
        <TextView
            android:id="@+id/tvInsultPhase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/insult_phase_1"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.14"
            android:textColor="#CCFFFFFF" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- L'insulto, al centro dello schermo -->
        <TextView
            android:id="@+id/tvInsult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="32sp"
            android:fontFamily="sans-serif-black"
            android:lineSpacingMultiplier="1.08"
            android:letterSpacing="-0.01"
            android:textColor="@color/white" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Secondi rimanenti -->
        <TextView
            android:id="@+id/tvInsultTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="60"
            android:textSize="46sp"
            android:textStyle="bold"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:textColor="@color/white"
            android:layout_marginBottom="20dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInsultOk"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/insult_btn_ok"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:letterSpacing="0"
            android:textColor="@color/home_bg"
            app:backgroundTint="@color/white"
            app:cornerRadius="14dp"
            app:elevation="0dp" />

    </LinearLayout>
</FrameLayout>
