<?xml version="1.0" encoding="utf-8"?>
<!--
    Insultami: un minuto di caos. Pensato per chi NON guarda lo schermo:
    countdown arancione gigante su nero che trema, voce, battito, vibrazione e flash.
    L'insulto scritto c'è, ma piccolo: tanto lo dice la voce.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/insultRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clipChildren="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_horizontal"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="24dp"
        android:paddingBottom="16dp">

        <!-- Fase corrente -->
        <TextView
            android:id="@+id/tvInsultPhase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:text="@string/insult_phase_1"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.14"
            android:textColor="@color/home_accent" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Countdown gigante: trema e si "sporca" (ombra rossa sfasata, impostata nel codice) -->
        <TextView
            android:id="@+id/tvInsultTimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="60"
            android:textSize="210sp"
            android:fontFamily="sans-serif-black"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:textColor="@color/home_accent" />

        <!-- La battuta, in una nuvoletta da fumetto. Altezza fissa: il countdown non salta -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginTop="8dp"
            android:clipChildren="false">

            <LinearLayout
                android:id="@+id/insultBubble"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:clipChildren="false">

                <TextView
                    android:id="@+id/tvInsult"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="300dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:background="@drawable/bg_insult_bubble"
                    android:gravity="center"
                    android:textSize="24sp"
                    android:fontFamily="sans-serif-black"
                    android:lineSpacingMultiplier="1.05"
                    android:textColor="#000000" />

                <!-- Beccuccio, dello stesso colore della nuvoletta (si sovrappone di poco) -->
                <FrameLayout
                    android:id="@+id/insultTail"
                    android:layout_width="26dp"
                    android:layout_height="22dp"
                    android:layout_gravity="start"
                    android:layout_marginStart="34dp"
                    android:layout_marginTop="-4dp">

                    <ImageView
                        android:id="@+id/ivInsultTailFill"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_bubble_tail_fill" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInsultOk"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/insult_btn_ok"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:letterSpacing="0"
            android:textColor="@color/home_bg"
            app:backgroundTint="@color/white"
            app:cornerRadius="14dp"
            app:elevation="0dp" />

    </LinearLayout>
</FrameLayout>
