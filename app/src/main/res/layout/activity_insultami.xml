<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/insultRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/alert_aggressive">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <!-- Fase corrente -->
        <TextView
            android:id="@+id/tvInsultPhase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/insult_phase_1"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:textColor="#FFFFFFCC"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/tvInsultEmoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💀"
            android:textSize="72sp"
            android:layout_marginBottom="24dp" />

        <!-- L'insulto -->
        <TextView
            android:id="@+id/tvInsult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="160dp"
            android:gravity="center"
            android:textSize="30sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/white"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="32dp" />

        <!-- Secondi rimanenti -->
        <TextView
            android:id="@+id/tvInsultTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="60"
            android:textSize="48sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:textColor="@color/white"
            android:layout_marginBottom="40dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInsultOk"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:text="@string/insult_btn_ok"
            style="@style/Widget.Stacca.Button.Primary"
            android:backgroundTint="@color/white"
            android:textColor="@color/alert_apocalypse"
            android:textSize="20sp" />

    </LinearLayout>
</FrameLayout>
