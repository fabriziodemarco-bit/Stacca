<?xml version="1.0" encoding="utf-8"?>
<!--
    Impostazioni nello stile "editoriale" della home:
    stessa palette, intestazioni di sezione discrete, una scheda per sezione
    con le voci separate da una linea sottile.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Barra in alto: freccia indietro + titolo -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/home_bg"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/home_text"
            app:title="@string/home_settings"
            app:titleTextColor="@color/home_text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingBottom="16dp">

            <!-- Sezione Notifiche -->
            <TextView
                style="@style/Stacca.Settings.SectionLabel"
                android:text="@string/settings_section_notifications"
                android:layout_marginTop="8dp" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Stacca.Settings.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Suono -->
                    <LinearLayout style="@style/Stacca.Settings.Row">
                        <LinearLayout style="@style/Stacca.Settings.RowTexts">
                            <TextView
                                style="@style/Stacca.Settings.RowTitle"
                                android:text="@string/settings_sound" />
                            <TextView
                                style="@style/Stacca.Settings.RowDesc"
                                android:text="@string/settings_sound_desc" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchSound"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View style="@style/Stacca.Settings.Divider" />

                    <!-- Vibrazione -->
                    <LinearLayout style="@style/Stacca.Settings.Row">
                        <LinearLayout style="@style/Stacca.Settings.RowTexts">
                            <TextView
                                style="@style/Stacca.Settings.RowTitle"
                                android:text="@string/settings_vibration" />
                            <TextView
                                style="@style/Stacca.Settings.RowDesc"
                                android:text="@string/settings_vibration_desc" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchVibration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View style="@style/Stacca.Settings.Divider" />

                    <!-- Schermo intero -->
                    <LinearLayout style="@style/Stacca.Settings.Row">
                        <LinearLayout style="@style/Stacca.Settings.RowTexts">
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">
                                <TextView
                                    style="@style/Stacca.Settings.RowTitle"
                                    android:text="@string/settings_fullscreen" />
                                <!-- Etichetta PREMIUM: solo per chi è nel piano gratuito -->
                                <TextView
                                    android:id="@+id/tagFullScreenPremium"
                                    style="@style/Stacca.Settings.PremiumTag" />
                            </LinearLayout>
                            <TextView
                                style="@style/Stacca.Settings.RowDesc"
                                android:text="@string/settings_fullscreen_desc" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchFullScreen"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View style="@style/Stacca.Settings.Divider" />

                    <!-- Flash durante Insultami -->
                    <LinearLayout style="@style/Stacca.Settings.Row">
                        <LinearLayout style="@style/Stacca.Settings.RowTexts">
                            <TextView
                                style="@style/Stacca.Settings.RowTitle"
                                android:text="@string/settings_flash" />
                            <TextView
                                style="@style/Stacca.Settings.RowDesc"
                                android:text="@string/settings_flash_desc" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchFlash"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sezione Comportamento -->
            <TextView
                style="@style/Stacca.Settings.SectionLabel"
                android:text="@string/settings_section_behavior" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Stacca.Settings.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            style="@style/Stacca.Settings.RowTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/settings_escalation_speed" />

                        <TextView
                            android:id="@+id/tagSpeedPremium"
                            style="@style/Stacca.Settings.PremiumTag"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:id="@+id/tvSpeedLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFeatureSettings="tnum"
                            android:textColor="@color/home_accent" />
                    </LinearLayout>

                    <TextView
                        style="@style/Stacca.Settings.RowDesc"
                        android:text="@string/settings_escalation_speed_desc" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderEscalation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:valueFrom="0"
                        android:valueTo="2"
                        android:stepSize="1"
                        app:trackColorActive="@color/home_accent"
                        app:trackColorInactive="@color/home_border"
                        app:thumbColor="@color/home_accent"
                        app:tickColorActive="@color/home_on_accent"
                        app:tickColorInactive="@color/home_text_secondary"
                        app:labelBehavior="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sezione Piano: Premium, prova o gratis -->
            <TextView
                style="@style/Stacca.Settings.SectionLabel"
                android:text="@string/settings_section_plan" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Stacca.Settings.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvPlanTitle"
                        style="@style/Stacca.Settings.RowTitle" />

                    <TextView
                        android:id="@+id/tvPlanDesc"
                        style="@style/Stacca.Settings.RowDesc" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPlanUnlock"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="14dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/plan_unlock"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:letterSpacing="0"
                        android:textColor="@color/home_on_accent"
                        app:backgroundTint="@color/home_accent"
                        app:cornerRadius="14dp" />

                    <TextView
                        android:id="@+id/tvPlanRestore"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:paddingTop="8dp"
                        android:paddingBottom="4dp"
                        android:background="?attr/selectableItemBackground"
                        android:text="@string/premium_restore"
                        android:textSize="13sp"
                        android:textColor="@color/home_text_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sezione Account -->
            <TextView
                style="@style/Stacca.Settings.SectionLabel"
                android:text="@string/settings_section_account" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Stacca.Settings.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvAccountStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:textColor="@color/home_text"
                        android:layout_marginBottom="14dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAccountAction"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:letterSpacing="0"
                        android:textColor="@color/home_text"
                        app:strokeColor="@color/home_border"
                        app:strokeWidth="1dp"
                        app:cornerRadius="14dp" />

                    <!-- Elimina account: solo per chi ha fatto l'accesso, apre la pagina web di richiesta -->
                    <TextView
                        android:id="@+id/tvDeleteAccount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:paddingTop="8dp"
                        android:paddingBottom="4dp"
                        android:background="?attr/selectableItemBackground"
                        android:text="@string/settings_delete_account"
                        android:textSize="13sp"
                        android:textColor="@color/home_text_secondary"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Versione -->
            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_version"
                android:textSize="13sp"
                android:textColor="@color/text_hint"
                android:gravity="center"
                android:layout_marginTop="28dp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
